# Caddy terminates TLS and serves both the SPA and the API on one origin.
# SITE_ADDRESS comes from the environment (see .env.production.example).
{
	admin localhost:2019
}

{$SITE_ADDRESS} {
	# Compress everything but MCP: its event stream must reach agents event by
	# event, not whenever a compression buffer happens to fill.
	@compressible not path /mcp /mcp/*
	encode @compressible zstd gzip

	# The API always lives under /api and keeps its own /api prefix.
	handle /api/* {
		reverse_proxy api:3000
	}

	# MCP for AI agents sits next to /api: /mcp, plus /mcp/messages for old SSE
	# clients. Without this block the SPA below answers /mcp with index.html.
	# flush_interval -1 passes the event stream through unbuffered.
	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	# React Router owns the rest of the URL space; unknown paths get the SPA.
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Private customer ticket links, SSO callback, and worker inbox pages must
	# not be indexed or leak URLs via the HTTP Referer header.
	@private path /t/* /inbox /inbox/* /sso/* /thanks
	header @private {
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow"
	}

	log {
		output stdout
		# Never let customer secret links, the admin token or future session
		# cookies reach the log. The path is enough to identify the request.
		format filter {
			wrap json
			fields {
				request>headers>X-Ticket-Token delete
				request>headers>X-Admin-Token delete
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}

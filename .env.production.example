# Copy to .env on the server and keep it at mode 0600. Docker Compose reads this
# file for ${...} substitution and passes it to the api container.
SITE_ADDRESS=team-09.fasthacks.cloud

# Where the SPA is reachable; secret ticket links are built from this.
PUBLIC_WEB_URL=https://team-09.fasthacks.cloud

# Required. GET /api/admin/export is disabled while this is empty. Generate one
# with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
ADMIN_TOKEN=

# One origin serves the SPA and /api, so the browser never makes a CORS request.
CORS_ALLOWED_ORIGINS=

RUST_LOG=info,tower_http=info

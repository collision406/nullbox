# Copy to .env on the server and keep it at mode 0600. Docker Compose reads this
# file for ${...} substitution and passes it to the api container.
SITE_ADDRESS=team-09.fasthacks.cloud

# Where the SPA is reachable; secret ticket links are built from this.
PUBLIC_WEB_URL=https://team-09.fasthacks.cloud

# Required. GET /api/admin/export is disabled while this is empty. Generate one
# with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
ADMIN_TOKEN=

# One origin serves the SPA and /api, so the browser never makes a CORS request.
CORS_ALLOWED_ORIGINS=

RUST_LOG=info,tower_http=info

# Stripe Checkout for /buy. A TEST key only (sk_test_… or rk_test_…): a live key stops the API
# from starting. Leave empty to turn payments off (POST /api/checkout answers 503).
STRIPE_API_KEY=

# Required behind Caddy: the client IP for rate limits and the audit log is then read from the
# X-Forwarded-For header Caddy sets. Without it every visitor shares one rate-limit bucket.
TRUST_PROXY=true

# Sign-up is open to anyone while this is empty, and every account can read the inbox. Set a
# code (8+ characters) to require it at sign-up; the login screen then asks for it.
SIGNUP_INVITE_CODE=

# Copy to .env for local development (read by dotenvy). All settings: crates/api/src/config.rs
BIND_ADDR=127.0.0.1:3000
DATABASE_URL=sqlite://nullbox.db
# Build against the .sqlx cache: with DATABASE_URL alone, compiling fails until nullbox.db exists.
SQLX_OFFLINE=true
# Comma-separated. The web app runs on a different origin, like a Tauri webview would.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Where the web app lives; secret access links point here.
PUBLIC_WEB_URL=http://localhost:5173
# Unlocks /api/admin/* (header X-Admin-Token). There is no default: while this is unset the
# admin endpoints refuse everyone. At least 32 characters, e.g. `openssl rand -base64 32`.
# Never commit the real value.
# ADMIN_TOKEN=
# Requests per client IP per minute: all routes, and new tickets only. 0 disables a limit.
# RATE_LIMIT_PER_MINUTE=300
# RATE_LIMIT_CREATE_PER_MINUTE=10
# Set to true ONLY behind your own reverse proxy: the client IP is then read from X-Forwarded-For.
# TRUST_PROXY=false
# Stripe Checkout for /buy. TEST keys only (sk_test_… or rk_test_…): live keys are refused at
# startup. Unset = POST /api/checkout answers 503. Never commit the real value.
# STRIPE_API_KEY=
# Sign-ups and log-ins per client IP per minute: what stops password guessing. 0 disables.
# RATE_LIMIT_AUTH_PER_MINUTE=10
# Sign-up is open to anyone by default, and every account can read the inbox. Set a code
# (8+ characters) to require it. Never commit the real value.
# SIGNUP_INVITE_CODE=
# Bearer token for AI agents at /mcp (docs/MCP.md); they act as agent:<client name>. Unset =
# only workers' own session tokens open /mcp. At least 32 characters. Never commit the real value.
# MCP_TOKEN=
# A request that takes longer is answered with 503.
# REQUEST_TIMEOUT_SECS=30
RUST_LOG=info,tower_http=debug
